# Telegram
BOT_TOKEN=replace_me
BOT_RUN_MODE=webhook
WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USER_IDS=397691221

# Web app
WEBAPP_URL=https://telegram-miniapp-1-r0sj.onrender.com
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# PORT задаёт Render автоматически; локально берётся WEBAPP_PORT.
# APP_VERSION обычно не задают в окружении — авторитетный дефолт в config.py.
APP_VERSION=

# Database
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.4-mini
OPENAI_PROMPT_ID=
OPENAI_PROMPT_VERSION=
OPENAI_PROMPT_FOR_VOICE=0
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_VOICE_TTS_VOICE=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=png
OPENAI_IMAGE_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=medium
OPENAI_VOICE_REASONING_EFFORT=low
OPENAI_REALTIME_REASONING_EFFORT=low

# Limits
CHAT_HISTORY_LIMIT=8
# Ретенция истории чата на пользователя (старше — чистится при записи). 0 = выкл.
CHAT_RETENTION_PER_USER=50
CHAT_MAX_TOKENS=240
VOICE_MAX_TOKENS=260
AI_DAILY_MESSAGE_LIMIT=0
# Суточный лимит на старт дорогих Realtime-сессий (per-user). 0 = выключено.
REALTIME_DAILY_SESSION_LIMIT=40
API_RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30
OPENAI_INPUT_COST_PER_1M=0.75
OPENAI_OUTPUT_COST_PER_1M=4.50
# Корень файловых кэшей (картинки слов, озвучка, фото). По умолчанию
# <static>/generated (эфемерный диск Render — стирается при деплое).
# Укажи путь к смонтированному persistent disk, чтобы кэши переживали деплой.
# CACHE_ROOT=/var/data/cache

# Облачное хранилище кэшей (Cloudflare R2, S3-совместимое). Если заданы ВСЕ
# четыре переменные — кэши картинок/озвучки/фото уходят в R2 и переживают деплой
# (бакет приватный, раздаём прокси через сервер). Если не заданы — локальный диск.
# R2_BUCKET=tutor-cache
# R2_ACCOUNT_ID=xxxxxxxxxxxx           # или задай R2_ENDPOINT_URL напрямую
# R2_ENDPOINT_URL=https://<acc>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_REGION=auto

# Лимиты дискового кэша (см. webapp/server.py)
AUDIO_CACHE_MAX_FILES=4000
VOCAB_IMAGE_CACHE_MAX_FILES=4000

# Tutor behavior
TUTOR_DEFAULT_LEVEL=beginner
TUTOR_DEFAULT_STYLE=игровой, доброжелательный, короткими репликами
TUTOR_DEFAULT_TOPICS=животные, еда, цвета, игры, школа, путешествия, истории
TUTOR_CORRECTION_MODE=мягко исправлять и сразу давать правильный пример
TUTOR_LANGUAGE_BALANCE=отвечать на языке ученика; при трудности объяснять по-русски и давать простую английскую фразу

# Gamification
DAILY_LESSON_REWARD_POINTS=25
GAME_POINTS_CORRECT=8
GAME_PERFECT_BONUS_POINTS=10
